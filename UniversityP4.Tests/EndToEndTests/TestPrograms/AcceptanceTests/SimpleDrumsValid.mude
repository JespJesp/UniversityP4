% Valid test: simple drum loop should work %

sample kick "/ExamplePrograms/Samples/Drums/kick A#.wav" a2
sample snare "/ExamplePrograms/Samples/Drums/snare.wav" c3
sample hihat "/ExamplePrograms/Samples/Drums/closed hihat.wav" f4

melody 4_drums
	chords
		0,1 kick(gain 3.0)
		1,2 hihat(gain 0.5)
		2,3 snare(gain 2.5)
		3,4 hihat(gain 0.5)

timeline
	settings
		bpm 120
		timesignature 4,4
	start 0
		4_drums
	stop 4
		4_drums