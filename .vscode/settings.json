{
  // Indent styling
  "editor.tabSize": 3,
  "editor.insertSpaces": false,
  "editor.detectIndentation": false,

  // Requires extension: emeraldwalk.runonsave
  "emeraldwalk.runonsave": {
    "commands": [
      {
        // macOS/Linux path style: no backslashes in absolute path
        "match": "\\.mude$",
        "notMatch": "\\\\",
        "isAsync": true,
        "cmd": "out_file=\"${workspaceFolder}/ExamplePrograms/ProgramOutput.wav\"; dotnet run --project \"${workspaceFolder}/UniversityP4.csproj\" -- \"${file}\" && cp -f \"${workspaceFolder}/ProgramOutput.wav\" \"$out_file\" && (killall afplay >/dev/null 2>&1 || true) && afplay \"$out_file\""
      },
      {
        // Windows path style: backslashes in absolute path
        "match": "\\.mude$",
        "notMatch": "/",
        "isAsync": true,
        "cmd": "dotnet run --project \"${workspaceFolder}\\\\UniversityP4.csproj\" -- \"${file}\" && powershell -NoProfile -Command \"$outFile='${workspaceFolder}\\\\ExamplePrograms\\\\ProgramOutput.wav'; Copy-Item '${workspaceFolder}\\\\ProgramOutput.wav' $outFile -Force; $player = New-Object System.Media.SoundPlayer $outFile; $player.PlaySync()\""
      }
    ]
  }
}
