string drumsFolder "/Samples/Drums"

sample kick drumsFolder+"/kick A#.wav" a2
sample snare drumsFolder+"/snare.wav" c3

melody 4_basicBeat
	chords
		0,1 kick
		1,2 snare
		2,3 kick
		3,4 snare

timeline
	settings
		timeSignature 4/4
		bpm 140
	intro start 0
		4_basicBeat
	intro stop 4
		4_basicBeat
