
string instrumentsFolder "../../Samples/Instruments"

sample pluck instrumentsFolder + "/electric guitar E4.wav" e4
sample guitar instrumentsFolder + "/electric guitar E2.wav" e5

string drumsFolder "../../Samples/Drums"

sample kick drumsFolder + "/kick A#.wav" a#5
sample hihat drumsFolder + "/closed hihat.wav" c4
sample snare drumsFolder + "/clap.wav" c4

