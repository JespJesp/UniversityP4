% Valid test: simple drum loop should work %

sample kick "/../Samples/Drums/kick A#.wav" a2
sample snare "/../Samples/Drums/snare.wav" c3
sample hihat "/../Samples/Drums/closed hihat.wav" f4

melody 4_drums
	chords
		0,1 kick(gain 3.0)
		1,2 hihat(gain 0.5)
		2,3 snare(gain 2.5)
		3,4 hihat(gain 0.5)

timeline
	settings
		bpm 120
		timesignature 4/4
	drums start 0
		4_drums
	drums stop 4
		4_drums