
sample guitar "/Samples/Instruments/electric guitar E4.wav" e4
sample flute "/Samples/Instruments/flute E.wav" e5
sample kick "/Samples/Drums/kick A#.wav" a2
sample snare "/Samples/Drums/snare.wav" c3
sample hihat "/Samples/Drums/closed hihat.wav" f4
sample clap "/Samples/Drums/clap.wav" c2

melody 8_introGuitar
	samples
		guitar
	chords
		0 2 c4(gain 0.7)
		2 4 e4(gain 0.7)
		4 6 g4(gain 0.7)
		6 8 c5(gain 0.7)

melody 16_verseFlute
	samples
		flute
	chords
		0 4 e5(gain 0.6)
		4 8 d5(gain 0.6)
		8 12 c5(gain 0.6)
		12 14 d5(gain 0.6)
		14 16 e5(gain 0.6)

melody 4_drumPattern
	chords
		0 1 kick
		1 2 hihat
		2 3 snare
		3 4 hihat

