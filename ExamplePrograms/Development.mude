
% This is a comment %

import "DevelopmentImport.mude"

% 
This is a 
multi-line comment
%

% This string is also defined in the imported Development2.mude, but it will be overwritten in this file %
string electricGuitarSample "/electric guitar E4.wav" 

sample kick drumsFolder+"/kick A#.wav" a#5
sample hihat drumsFolder+"/closed hihat.wav"
sample clap drumsFolder+"/clap.wav"
sample snare drumsFolder+"/snare.wav"

sample guitar instrumentsFolder+electricGuitarSample e4
sample flute instrumentsFolder+"/flute E.wav" e5
sample synth instrumentsFolder+"/synth C.wav" c5
sample siren instrumentsFolder+"/Siren C.wav" c5
sample sirenWithStereoPan instrumentsFolder+"/Siren C stereo half pan to the right.wav" c5

float exampleNumber 0.9

melody 24_panTest
	samples
		sirenWithStereoPan
	chords
		0,8 a4(gain 0.2) c5(gain 0.2) e5(pan -1, gain 0.2)
		10,12 b5(gain exampleNumber, pan 0.5)
		8,10 b5(gain 0.2, pan 0)
		12,14 b5(gain 1/4, pan 1)
		14,16 b5(gain 1.4*3, pan -0.5)
		16,24 b5(gain 1.4*3, pan -1)

float kickGain 1.5

melody 8_kickAndSnare
	chords
		0,2 kick(gain kickGain)
		2,4 kick(gain kickGain)
		2,4 snare(gain 0.8)
		4,6 kick(gain kickGain)
		6,8 kick(gain kickGain)
		6,8 snare(gain 0.8)

melody 4_hihat
	chords
		1,2 hihat(gain 0.05)
		3,4 hihat(gain 0.05)

melody 16_fastChords
	samples
		synth
	chords
		0,4 a4 c5 e5
		1,4 a4 c5 e5
		2,4 a4 c5 e5
		3,4 a4 c5 e5
		4,8 g4 b5 d5
		5,8 g4 b5 d5
		6,8 g4 b5 d5
		7,8 g4 b5 d5
		8,12 f4 a4 c5
		9,12 f4 a4 c5
		10,12 f4 a4 c5
		11,12 f4 a4 c5
		12,16 e4 g4 b4
		13,16 e4 g4 b4
		14,16 e4 g4 b4
		15,16 e4 g4 b4

melody 16_slowChords
	samples
		guitar
	chords
		0,4 a4 c5 e5
		4,8 g4 b5 d5
		8,12 f4 a4 c5
		12,16 e4 g4 b4

melody 16_flute
	samples
		flute
	chords
		0,3 a4
		3,3.5 a4
		3.5,4 b4
		4,6 e5
		0+8,2+8 c5
		3+8,3.5+8 d5
		3.5+8,4+8 c5
		4+8,6+8 b4

timeline
	settings
		bpm 160
		timesignature 4,4
	start 0
		16_fastChords
	start 16
		8_kickAndSnare
		4_hihat
	stop 32
		8_kickAndSnare
		4_hihat
	stop 64
		EVERYTHING
	start 0 (gain 0.15)
		16_slowChords
	start 0
		16_flute
	stop 16
		EVERYTHING
	start 8
		24_panTest
	stop 24
		24_panTest
